# Application Configuration
VITE_APP_ID=amber-ink-demo

# Backend API Endpoints (Aggregated port 8080)
# These all point to the same backend container in the default setup.
VITE_CLOUD_FUNCTION_URL=http://localhost:8080/onboardingAgent
VITE_REGISTER_USER_URL=http://localhost:8080/registerUser
VITE_CHECKIN_URL=http://localhost:8080/checkIn
VITE_GET_USER_DATA_URL=http://localhost:8080/getUserData
VITE_COMPANION_AGENT_URL=http://localhost:8080/companionAgent
VITE_DOWNLOAD_MEMORIAL_URL=http://localhost:8080/downloadMemorial

# Admin Tools
VITE_RUN_AI_ANALYZER_URL=http://localhost:8080/runAiAnalyzer
VITE_RUN_DELIVERY_ENGINE_URL=http://localhost:8080/runDeliveryEngine
VITE_RUN_EMERGENCY_MONITOR_URL=http://localhost:8080/runEmergencyMonitor

# Note: All endpoints point to localhost for demo purposes.
# Gemini API Key must be set in the /functions/.env or root .env file.
