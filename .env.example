# Global Environment Variables (Backend)
# ---------------------------------------------------------
# This file is the "Single Source of Truth" for backend configuration.
# Copy this to .env at the project root.

# Gemini API Configuration
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash
APP_ID=amber-ink

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
# Example Atlas: MONGODB_URI=mongodb+srv://[USER]:[PASS]@[CLUSTER].mongodb.net/amber_ink?retryWrites=true&w=majority
MONGODB_DB_NAME=amber_ink

# Delivery Service Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
BASE_FUNCTION_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Security & Logic
ADMIN_TOKEN=your-secret-token-here
EMERGENCY_THRESHOLD_DAYS=3
